{
  "name": "atomnano",
  "version": "1.0.0",
  "description": "AtomNano — a beautiful desktop GUI for Claude Code (Windows + macOS), powered by the Claude Agent SDK.",
  "author": {
    "name": "Atom AI Labs",
    "email": ""
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "bin": {
    "atomnano": "bin/atomnano.js"
  },
  "scripts": {
    "cli": "node bin/atomnano.js",
    "icon": "node scripts/generate-icon.js",
    "build:cm": "esbuild src/renderer/editor/cm-src.js --bundle --splitting --format=esm --minify --target=chrome120 --outdir=src/renderer/editor --entry-names=cm.bundle --chunk-names=cmchunk/[hash] && esbuild src/renderer/editor/cm-worker.js --bundle --format=esm --minify --target=chrome120 --outfile=src/renderer/editor/cm-worker.bundle.js",
    "build:term": "esbuild src/renderer/vendor/xterm-entry.js --bundle --minify --format=iife --target=chrome120 --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.ttf=dataurl --outfile=src/renderer/vendor/xterm.bundle.js",
    "rebuild:term": "node scripts/rebuild-pty.js",
    "postinstall": "node scripts/rebuild-pty.js",
    "test": "node scripts/test-audit.js && node scripts/test-platform.js && node scripts/test-credstore.js && node scripts/test-tool-cards.js && node scripts/test-taskbar-tile.js && node scripts/test-transfer.js && node scripts/test-context.js && node scripts/test-permissions.js && node scripts/test-run-control.js && node scripts/test-git.js && node scripts/test-git-ui.js && node scripts/_xcheck-db-ipc.js && node scripts/test-db.js && node scripts/test-db-ui.js",
    "test:tool-cards": "node scripts/test-tool-cards.js",
    "test:taskbar-tile": "node scripts/test-taskbar-tile.js",
    "test:appearance-e2e": "node smoke-tests/test-appearance-tile.js",
    "test:transfer": "node scripts/test-transfer.js",
    "test:context": "node scripts/test-context.js",
    "test:context-e2e": "node smoke-tests/test-synthesize.js",
    "test:permissions": "node scripts/test-permissions.js",
    "test:run-control": "node scripts/test-run-control.js",
    "test:db": "node scripts/test-db.js",
    "test:db-ui": "node scripts/test-db-ui.js",
    "test:db-e2e": "node smoke-tests/test-db-manager.js",
    "test:git": "node scripts/test-git.js",
    "test:git-ui": "node scripts/test-git-ui.js",
    "test:git-e2e": "node smoke-tests/test-git-multi.js && node smoke-tests/test-git-conflict.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "npm run icon && npm run build:cm && npm run build:term && electron-builder --win --dir",
    "dist": "npm run icon && npm run build:cm && npm run build:term && electron-builder --win",
    "pack:mac": "npm run icon && npm run build:cm && npm run build:term && electron-builder --mac --dir",
    "dist:mac": "npm run icon && npm run build:cm && npm run build:term && electron-builder --mac dmg zip --publish never",
    "mac:build": "powershell -NoProfile -ExecutionPolicy Bypass -File mac/build-mac.ps1",
    "test:platform": "node scripts/test-platform.js",
    "test:credstore": "node scripts/test-credstore.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@openai/codex-sdk": "^0.153.4",
    "better-sqlite3": "^13.0.3",
    "mongodb": "^7.6.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.24.3",
    "node-pty": "^1.1.0",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.8.3",
    "pyright": "^1.1.410",
    "redis": "^6.2.1",
    "sql.js": "^1.10.3",
    "typescript": "^6.0.3",
    "vscode-jsonrpc": "^9.0.0",
    "vscode-languageserver-protocol": "^3.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@emmetio/codemirror6-plugin": "^0.4.1",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "editorconfig": "^3.0.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.60.0"
  }
}
