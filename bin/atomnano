#!/bin/sh
# AtomNano CLI shim (macOS / Linux / Git Bash). The running app exports ATOMNANO_NODE (its own
# runtime, Electron run as Node) so the CLI works even where no `node` is installed; otherwise
# the `node` on PATH runs it. See bin/atomnano.js.
dir=$(dirname "$0")
if [ -n "$ATOMNANO_NODE" ] && [ -x "$ATOMNANO_NODE" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$ATOMNANO_NODE" "$dir/atomnano.js" "$@"
fi
exec node "$dir/atomnano.js" "$@"
